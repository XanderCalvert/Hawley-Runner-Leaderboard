# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
STRAVA_CLIENT_SECRET=replace-me
STRAVA_VERIFY_TOKEN=replace-me
APP_SECRET=replace-with-output-of-node-scripts/make-secret.mjs
ADMIN_TOKEN=replace-with-output-of-node-scripts/make-secret.mjs
# Uncomment to run against the fake Strava (npm run mock:strava)
# STRAVA_OAUTH_BASE=http://localhost:8788
# STRAVA_API_BASE=http://localhost:8788/api/v3
