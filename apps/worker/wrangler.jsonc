{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "club-recap",
    "main": "src/index.ts",
    "compatibility_date": "2025-09-01",
    "observability": { "enabled": true },

    // Hourly: sync a small batch of athletes to catch anything the webhook missed.
    "triggers": { "crons": ["17 * * * *"] },

    "d1_databases": [
        {
            "binding": "DB",
            // From: npx wrangler d1 create club-recap (an ID, not a credential)
            "database_id": "5d2ee2ca-7461-43e1-bc48-20f9069ed9c9",
            "database_name": "club-recap",
            "migrations_dir": "migrations"
        }
    ],

    "vars": {
        // Your Strava API application's Client ID (public).
        "STRAVA_CLIENT_ID": "131632",
        // Strava API base. https://api-v3.strava.com is available from 4 Jan 2027 and required by 1 Jun 2027.
        "STRAVA_API_BASE": "https://www.strava.com/api/v3",
        // Where the static site lives (GitHub Pages). No trailing slash.
        "WEB_BASE_URL": "https://xandercalvert.github.io/Hawley-Runner-Leaderboard",
        // Comma-separated origins allowed to call /api and /admin from a browser.
        "ALLOWED_ORIGINS": "https://xandercalvert.github.io,http://localhost:5173"
    }

    // Secrets (never in this file). Set each with: npx wrangler secret put NAME
    //   STRAVA_CLIENT_SECRET   from strava.com/settings/api
    //   STRAVA_VERIFY_TOKEN    any random string; reused when creating the webhook subscription
    //   APP_SECRET             32+ random bytes, base64 (signs OAuth state, encrypts tokens)
    //   ADMIN_TOKEN            long random string for the admin page
    // Optional var once the webhook exists:
    //   STRAVA_SUBSCRIPTION_ID
}
